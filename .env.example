# Copy this file to .env and fill in your own values.
# The real .env is gitignored; this template is committed so the project
# is reproducible by anyone who clones the repo.

# Anthropic API key for the model calls. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---- optional: models -------------------------------------------------------
# CLAUSEGUARD_MODEL=claude-sonnet-5                 # main reasoning model
# CLAUSEGUARD_MODEL_FAST=claude-haiku-4-5-20251001  # router + resolution judge

# ---- optional: behaviour ----------------------------------------------------
# CLAUSEGUARD_ROUTING=agentic     # agentic (default, eval winner) | auto (rule + Haiku router) | single
# CLAUSEGUARD_JUDGE=1             # second-pass review of resolution language
# CLAUSEGUARD_PLAYBOOK=1          # lookup_playbook tool / inline playbook context
# CLAUSEGUARD_REDACT=0            # replace emails/phones/SSNs/cards with stable tokens before analysis
# CLAUSEGUARD_OCR=0               # OCR scanned PDFs (needs Tesseract + pytesseract)
# TESSERACT_CMD=                  # path to tesseract binary if not on PATH

# ---- optional: limits -------------------------------------------------------
# CLAUSEGUARD_TOKEN_CEILING=250000   # abort an analysis past this many tokens
# CLAUSEGUARD_MAX_TURNS=12
# CLAUSEGUARD_TIMEOUT_S=120
# CLAUSEGUARD_RATE_LIMIT_PER_MIN=10

# ---- optional: deployment ---------------------------------------------------
# CLAUSEGUARD_DEMO=0                 # 1 = replay demo/sample_trace.json, uploads disabled
# CLAUSEGUARD_API_KEY=               # bearer token required on /upload and /analyze when set
# CLAUSEGUARD_CORS_ORIGINS=http://localhost:3000
# CLAUSEGUARD_AUDIT_LOG=logs/audit.jsonl
# CLAUSEGUARD_OTEL=0                 # mirror spans to an OpenTelemetry tracer if configured
